{
  "name": "raylib",
  "version": "0.1.0",
  "exports": "./raylib.ts",
  "tasks": {
    "generate": "deno run --allow-read --allow-write bindings/generators/generate_layouts.ts && deno run --allow-read --allow-write bindings/generators/generate_ffi_structs.ts && deno run --allow-read --allow-write bindings/generators/generate_structs.ts && deno run --allow-read --allow-write bindings/generators/generator.ts && deno fmt deno.jsonc bindings"
  },
  "compilerOptions": {
    "types": [
      "./global.d.ts"
    ]
  },
  "imports": {
    "raylib": "./raylib.ts"
  }
}
